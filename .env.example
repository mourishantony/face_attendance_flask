# ── Flask ───────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string

# ── Admin ───────────────────────────────────────────────────────────
# PIN to log in to the admin panel (digits only, min 4)
ADMIN_PIN=1827

# ── MongoDB Atlas ───────────────────────────────────────────────────
# Paste your Atlas connection string (srv format recommended)
# e.g.: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/attendance
MONGODB_DB=attendance

# ── Hugging Face Space ──────────────────────────────────────────────
# Full URL of your deployed HF Space (no trailing slash)
# e.g.: https://your-username-face-embedding-api.hf.space
HF_EMBED_URL=

# ── Attendance defaults (can be overridden in Admin > Settings) ─────
TIMEZONE=Asia/Kolkata
ATTEND_START=00:00
ATTEND_END=21:00

# ── Dev only ────────────────────────────────────────────────────────
FLASK_DEBUG=0
